
Queries

A. Customer Analysis
* Display all customers.

SELECT *
FROM customers;

* Display customer names and their cities.

SELECT
    customer_name,
    city
FROM customers;

* Find all unique customer cities.

SELECT DISTINCT city
FROM customers;

* Which cities have the highest number of customers?

SELECT
    city,
    COUNT(*) AS total_customers
FROM customers
GROUP BY city
ORDER BY total_customers DESC;

* Who are the top 10 customers based on total food spending where orders are delivered?

SELECT
    c.customer_id,
    c.customer_name,
    SUM(oi.quantity * oi.unit_price) AS total_spending
FROM customers c
JOIN orders o
    ON c.customer_id = o.customer_id
JOIN order_items oi
    ON o.order_id = oi.order_id
WHERE o.order_status = 'Delivered'
GROUP BY
    c.customer_id,
    c.customer_name
ORDER BY total_spending DESC
LIMIT 10;


B. Restaurant Performance Analysis

* Display all restaurant names and their cuisines.

SELECT
    restaurant_name,
    cuisine
FROM restaurants;

* Find restaurants located in Mumbai.

SELECT
    restaurant_name,
    city
FROM restaurants
WHERE city = 'Mumbai';

* Find restaurants serving Indian or Italian cuisine.

SELECT
    restaurant_name,
    cuisine
FROM restaurants
WHERE cuisine IN ('Indian', 'Italian');

* Count the number of restaurants in each city.

SELECT
    city,
    COUNT(*) AS total_restaurants
FROM restaurants
GROUP BY city
ORDER BY total_restaurants DESC;

* Which restaurants receive the highest number of orders?

SELECT
    r.restaurant_name,
    COUNT(o.order_id) AS total_orders
FROM restaurants r
LEFT JOIN orders o
    ON r.restaurant_id = o.restaurant_id
GROUP BY
    r.restaurant_id,
    r.restaurant_name
ORDER BY total_orders DESC;


C. Sales and Revenue Analysis

* Calculate the total number of orders placed.

SELECT
    COUNT(*) AS total_orders
FROM orders;

* Calculate the total food sales from delivered orders.

SELECT
    SUM(oi.quantity * oi.unit_price) AS total_food_sales
FROM orders o
JOIN order_items oi
    ON o.order_id = oi.order_id
WHERE o.order_status = 'Delivered';

* Calculate the average menu item price.

SELECT
    ROUND(AVG(price), 2) AS average_menu_price
FROM menu_items;

* Find the highest and lowest menu item prices.

SELECT
    MAX(price) AS highest_price,
    MIN(price) AS lowest_price
FROM menu_items;

* Calculate monthly order counts.

SELECT
    YEAR(order_time) AS order_year,
    MONTH(order_time) AS order_month,
    COUNT(*) AS total_orders
FROM orders
GROUP BY
    YEAR(order_time),
    MONTH(order_time)
ORDER BY
    order_year,
    order_month;


D. Food Item Analysis

* Display all available menu items.

SELECT
    item_name,
    category,
    price
FROM menu_items
WHERE is_available = TRUE;

* Find menu items priced above ₹200.
SELECT
    item_name,
    price
FROM menu_items
WHERE price > 200
ORDER BY price DESC;

* Find menu items whose names start with the letter 'C'.

SELECT
    item_name,
    price
FROM menu_items
WHERE item_name LIKE 'C%';

* Count the number of menu items in each category.

SELECT
    category,
    COUNT(*) AS total_items
FROM menu_items
GROUP BY category
ORDER BY total_items DESC;

* Find the average menu item price for each category.

SELECT
    category,
    ROUND(AVG(price), 2) AS average_price
FROM menu_items
GROUP BY category
ORDER BY average_price DESC;


E. Order and Delivery Analysis

* Display all orders and their statuses.
SELECT
    order_id,
    order_time,
    order_status
FROM orders;

* Find all cancelled orders.

SELECT
    order_id,
    customer_id,
    restaurant_id,
    cancellation_reason
FROM orders
WHERE order_status = 'Cancelled';

* Find orders that do not have an assigned delivery partner.

SELECT
    order_id,
    order_status
FROM orders
WHERE partner_id IS NULL;

* Count orders by their status which are deliverd and cancelled.

SELECT
    order_status,
    COUNT(*) AS total_orders
FROM orders
GROUP BY order_status
ORDER BY total_orders DESC;

* Classify orders as Completed, Cancelled, or In Progress.

SELECT
    order_id,
    order_status,
    CASE
        WHEN order_status = 'Delivered' THEN 'Completed'
        WHEN order_status = 'Cancelled' THEN 'Cancelled'
        ELSE 'In Progress'
    END AS order_category
FROM orders;


F. Payment Analysis

* Find all successful payments.

SELECT
    payment_id,
    order_id,
    payment_method,
    payment_amount
FROM payments
WHERE payment_status = 'Successful';

* Count the number of payments for each payment method.

SELECT
    payment_method,
    COUNT(*) AS total_transactions
FROM payments
GROUP BY payment_method
ORDER BY total_transactions DESC;

* Calculate the total value of successful payments.

SELECT
    SUM(payment_amount) AS successful_payment_value
FROM payments
WHERE payment_status = 'Successful';

* Calculate the average payment amount for each payment method.

SELECT
    payment_method,
    ROUND(AVG(payment_amount), 2) AS average_payment
FROM payments
GROUP BY payment_method
ORDER BY average_payment DESC;

* Which payment methods account for the highest successful transaction value?

SELECT
    payment_method,
    SUM(payment_amount) AS total_transaction_value
FROM payments
WHERE payment_status = 'Successful'
GROUP BY payment_method
ORDER BY total_transaction_value DESC;


